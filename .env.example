# Copy this file to `.env.local` and fill in real values.
# All NEXT_PUBLIC_* values are exposed to the browser bundle — never put secrets there.
# Everything else is server-only.

# ============================================
# Supabase  (Project Settings → API)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Direct Postgres connection — used ONLY by `pnpm db:setup` to apply migrations.
# Project Settings → Database → Connection string → "Direct connection" (NOT pooler).
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.<your-project>.supabase.co:5432/postgres

# Where the app runs. Localhost during dev; your production URL on Vercel.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# LLM providers
# ============================================
# Anthropic — needs access to claude-sonnet-4-5 and claude-haiku-4-5.
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — `text-embedding-3-small` must be enabled in the project's allowed-models list.
OPENAI_API_KEY=sk-proj-...

# ============================================
# Make.com  (Profile → API/MCP Access → Token)
# ============================================
# Token needs these scopes: organizations:read, teams:read, scenarios:read, scenarios-folders:read
MAKE_API_TOKEN=...
# Pick your region: https://eu1.make.com/api/v2 or https://us1.make.com/api/v2
MAKE_API_BASE_URL=https://eu1.make.com/api/v2
# The Make org you want to index — numeric id, visible in the Make URL when you open the org.
MAKE_DEFAULT_ORG_ID=12345

# ============================================
# Model routing  (override only if you know why)
# ============================================
LLM_MODEL_ANALYSIS=claude-sonnet-4-5-20250929
LLM_MODEL_CHAT=claude-haiku-4-5-20251001
LLM_MODEL_REUSE=claude-sonnet-4-5-20250929
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Bumping this forces a full re-analysis on next ingest (hash dedup is keyed on it).
# See AGENTS.md Rule 9.
PROMPT_VERSION=v1.0

# ============================================
# Cost guardrails (USD per day)
# ============================================
DAILY_LLM_BUDGET_USD=20
DAILY_EMBEDDING_BUDGET_USD=2

# ============================================
# Ingestion tuning
# ============================================
# Concurrent scenarios processed during a batch ingest. ≤5 stays under Anthropic Tier-2 rate limits.
INGEST_CONCURRENCY=5
INGEST_RATE_LIMIT_PER_MIN=30
