# Copy this file to `.env.local` and fill in real values.
# All NEXT_PUBLIC_* values are exposed to the browser bundle — never put secrets there.
# Everything else is server-only.

# ============================================
# Supabase  (Project Settings → API)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Direct Postgres connection — used ONLY by `pnpm db:setup` to apply migrations.
# Project Settings → Database → Connection string → "Direct connection" (NOT pooler).
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.<your-project>.supabase.co:5432/postgres

# ============================================
# LLM providers
# ============================================
# Anthropic — needs access to claude-sonnet-4-5 and claude-haiku-4-5.
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — `text-embedding-3-small` must be enabled in the project's allowed-models list.
OPENAI_API_KEY=sk-proj-...

# ============================================
# Make.com  (Profile → API/MCP Access → Token)
# ============================================
# Token needs these scopes: organizations:read, teams:read, scenarios:read, scenarios-folders:read
MAKE_API_TOKEN=...
# Pick your region — used by the API client to fetch scenarios.
# https://eu1.make.com/api/v2 or https://us1.make.com/api/v2
MAKE_API_BASE_URL=https://eu1.make.com/api/v2
# The Make org you want to index — numeric id, visible in the Make URL when you open the org.
MAKE_DEFAULT_ORG_ID=12345
# Base of the Make web UI — used to build "Open in Make" links on scenario detail pages.
# OPTIONAL: if unset, auto-derived from MAKE_API_BASE_URL (strips /api/v2). Only set if
# your web UI is on a different host than your API.
MAKE_WEB_BASE_URL=

# ============================================
# Model routing  (override only if you know why)
# ============================================
LLM_MODEL_ANALYSIS=claude-sonnet-4-5-20250929
LLM_MODEL_CHAT=claude-haiku-4-5-20251001
LLM_MODEL_REUSE=claude-sonnet-4-5-20250929
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Bumping this forces a full re-analysis on next ingest (hash dedup is keyed on it).
# See AGENTS.md Rule 9.
PROMPT_VERSION=v1.1

# ============================================
# Cost guardrails (USD per day)
# ============================================
# Enforced inside lib/llm/cost-tracking.ts before each paid LLM call.
# Sums chat + reuse + ingestion spend across the calendar day (UTC).
DAILY_LLM_BUDGET_USD=20
DAILY_EMBEDDING_BUDGET_USD=2

# ============================================
# Auto-grant on first sign-in  (optional but recommended for internal-company use)
# ============================================
# Auto-creates a `user_org_memberships` row on first sign-in if the email matches.
# Existing memberships are NEVER overwritten (script-granted access still wins).
# Target org = MAKE_DEFAULT_ORG_ID (above). Leave both vars empty to disable.
#
# Catchall: anyone with one of these domains → `member` role.
AUTO_GRANT_DOMAINS=
# Override: specific emails → `admin` role. Works for ANY domain (Gmail etc. is fine —
# does NOT need to also be in AUTO_GRANT_DOMAINS). Checked before the domain rule.
AUTO_GRANT_ADMIN_EMAILS=

# ============================================
# Ingestion tuning
# ============================================
# Concurrent scenarios processed during a batch ingest. ≤5 stays under Anthropic Tier-2 rate limits.
INGEST_CONCURRENCY=5

# ============================================
# UI niceties  (optional — sensible defaults exist)
# ============================================
# Where the sidebar "Give feedback" mailto points. Defaults to o.chekalov@make.com if unset.
NEXT_PUBLIC_FEEDBACK_EMAIL=

# OPTIONAL — overrides the built-in /changelog page with an external link instead.
# By default the sidebar version label points at /changelog (renders CHANGELOG.md
# from repo root). Set this if you want the link to open GitHub Releases / Commits
# / a hosted changelog in a new tab instead.
# e.g. https://github.com/your-org/scenario-kb/releases
NEXT_PUBLIC_CHANGELOG_URL=

# Server-side log verbosity. Set to "debug" while developing to see extra detail
# from lib/utils/logger; leave unset (defaults to info) in production.
LOG_LEVEL=
